{"neofx":2,"id":"black_white","name":"Black & White","category":"Color","params":[{"id":"amount","name":"Amount","min":0,"max":1,"default":1},{"id":"contrast","name":"Contrast","min":0.5,"max":2,"default":1.2}],"shader":"vec4 effect(vec2 uv) { vec4 c = texture2D(image, uv); float g = dot(c.rgb, vec3(0.299, 0.587, 0.114)); vec3 o = mix(c.rgb, vec3(g), amount); o = (o - vec3(0.5)) * contrast + vec3(0.5); return vec4(o, c.a); }"}
