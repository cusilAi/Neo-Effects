{"neofx":1,"id":"black_white","name":"Black & White","category":"Color","params":[{"id":"amount","name":"Amount","min":0,"max":1,"default":1},{"id":"contrast","name":"Contrast","min":0.5,"max":2,"default":1.2}],"shader":"uniform shader image; uniform float2 resolution; uniform float time; uniform float amount; uniform float contrast; half4 main(float2 p) { half4 c = image.eval(p); half g = dot(c.rgb, half3(0.299, 0.587, 0.114)); half3 o = mix(c.rgb, half3(g), half(amount)); o = (o - half3(0.5)) * half(contrast) + half3(0.5); return half4(o, c.a); }"}
