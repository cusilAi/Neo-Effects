{"neofx":2,"id":"blur","name":"Blur","category":"Blur","params":[{"id":"radius","name":"Radius","min":0,"max":40,"default":8}],"shader":"vec4 effect(vec2 uv) { vec2 px = radius / resolution; vec4 c = texture2D(image, uv); float n = 1.0; for (int i = 0; i < 8; i++) { float a = float(i) * 0.785398; vec2 d = vec2(cos(a), sin(a)); c += texture2D(image, uv + d * px * 0.5); c += texture2D(image, uv + d * px); n += 2.0; } return c / n; }"}
