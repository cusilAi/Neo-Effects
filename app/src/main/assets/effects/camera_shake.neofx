{"neofx":2,"id":"camera_shake","name":"Camera Shake","category":"Motion","params":[{"id":"amount","name":"Amount","min":0,"max":60,"default":14},{"id":"speed","name":"Speed","min":0.1,"max":10,"default":2},{"id":"zoom","name":"Zoom","min":1,"max":1.5,"default":1.06}],"shader":"vec4 effect(vec2 uv) { float t = time * speed; vec2 o = vec2(sin(t * 13.0) + sin(t * 7.3 + 1.0) * 0.5, cos(t * 11.0) + sin(t * 5.1 + 2.0) * 0.5) * amount / resolution; vec2 p = (uv - vec2(0.5, 0.5)) / zoom + vec2(0.5, 0.5); return texture2D(image, p + o); }"}
