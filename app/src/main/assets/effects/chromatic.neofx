{"neofx":2,"id":"chromatic","name":"Chromatic Aberration","category":"Glitch","params":[{"id":"amount","name":"Amount","min":0,"max":40,"default":10}],"shader":"vec4 effect(vec2 uv) { vec2 d = uv - vec2(0.5, 0.5); float k = amount / resolution.x; float r = texture2D(image, uv + d * k * 2.0).r; vec4 c = texture2D(image, uv); float b = texture2D(image, uv - d * k * 2.0).b; return vec4(r, c.g, b, c.a); }"}
