{"neofx":2,"id":"color_adjust","name":"Color Adjust","category":"Color","params":[{"id":"brightness","name":"Brightness","min":-0.5,"max":0.5,"default":0},{"id":"contrast","name":"Contrast","min":0,"max":2,"default":1},{"id":"saturation","name":"Saturation","min":0,"max":2,"default":1}],"shader":"vec4 effect(vec2 uv) { vec4 c = texture2D(image, uv); vec3 o = c.rgb + vec3(brightness); o = (o - vec3(0.5)) * contrast + vec3(0.5); float g = dot(o, vec3(0.299, 0.587, 0.114)); o = mix(vec3(g), o, saturation); return vec4(clamp(o, 0.0, 1.0), c.a); }"}
