{"neofx":2,"id":"color_grade","name":"Color Grade","category":"Grade","params":[{"id":"exposure","name":"Exposure","min":-2,"max":2,"default":0},{"id":"contrast","name":"Contrast","min":-1,"max":1,"default":0},{"id":"highlights","name":"Highlights","min":-1,"max":1,"default":0},{"id":"shadows","name":"Shadows","min":-1,"max":1,"default":0},{"id":"whites","name":"Whites","min":-1,"max":1,"default":0},{"id":"blacks","name":"Blacks","min":-1,"max":1,"default":0},{"id":"saturation","name":"Saturation","min":-1,"max":1,"default":0},{"id":"vibrance","name":"Vibrance","min":-1,"max":1,"default":0},{"id":"temperature","name":"Temperature","min":-1,"max":1,"default":0},{"id":"tint","name":"Tint","min":-1,"max":1,"default":0},{"id":"hue","name":"Hue","min":-0.5,"max":0.5,"default":0},{"id":"sharpen","name":"Sharpen","min":0,"max":2,"default":0},{"id":"grain","name":"Grain","min":0,"max":1,"default":0},{"id":"vignette","name":"Vignette","min":-1,"max":1,"default":0},{"id":"liftx","name":"Lift X","min":-1,"max":1,"default":0},{"id":"lifty","name":"Lift Y","min":-1,"max":1,"default":0},{"id":"liftm","name":"Lift","min":-0.5,"max":0.5,"default":0},{"id":"gammax","name":"Gamma X","min":-1,"max":1,"default":0},{"id":"gammay","name":"Gamma Y","min":-1,"max":1,"default":0},{"id":"gammam","name":"Gamma","min":-0.5,"max":0.5,"default":0},{"id":"gainx","name":"Gain X","min":-1,"max":1,"default":0},{"id":"gainy","name":"Gain Y","min":-1,"max":1,"default":0},{"id":"gainm","name":"Gain","min":-0.5,"max":0.5,"default":0},{"id":"cm1","name":"Curve M1","min":0,"max":1,"default":0.25},{"id":"cm2","name":"Curve M2","min":0,"max":1,"default":0.5},{"id":"cm3","name":"Curve M3","min":0,"max":1,"default":0.75},{"id":"cr1","name":"Curve R1","min":0,"max":1,"default":0.25},{"id":"cr2","name":"Curve R2","min":0,"max":1,"default":0.5},{"id":"cr3","name":"Curve R3","min":0,"max":1,"default":0.75},{"id":"cg1","name":"Curve G1","min":0,"max":1,"default":0.25},{"id":"cg2","name":"Curve G2","min":0,"max":1,"default":0.5},{"id":"cg3","name":"Curve G3","min":0,"max":1,"default":0.75},{"id":"cb1","name":"Curve B1","min":0,"max":1,"default":0.25},{"id":"cb2","name":"Curve B2","min":0,"max":1,"default":0.5},{"id":"cb3","name":"Curve B3","min":0,"max":1,"default":0.75}],"shader":"float rnd(vec2 s) { return fract(sin(dot(s, vec2(12.9898, 78.233))) * 43758.5453); } vec3 hsv2rgb(vec3 c) { vec3 p = abs(fract(c.xxx + vec3(1.0, 0.6666667, 0.3333333)) * 6.0 - vec3(3.0)); return c.z * mix(vec3(1.0), clamp(p - vec3(1.0), 0.0, 1.0), c.y); } vec3 wheelTint(float x, float y) { float r = min(length(vec2(x, y)), 1.0); float a = atan(y, x + 0.00001) / 6.2831853 + 0.5; return (hsv2rgb(vec3(a, 1.0, 1.0)) - vec3(0.5)) * r; } float crv(float x, float a, float b, float c) { float y = x; if (x < 0.25) { y = x * 4.0 * a; } else if (x < 0.5) { y = mix(a, b, (x - 0.25) * 4.0); } else if (x < 0.75) { y = mix(b, c, (x - 0.5) * 4.0); } else { y = mix(c, 1.0, (x - 0.75) * 4.0); } return y; } vec4 effect(vec2 uv) { vec4 src = texture2D(image, uv); vec3 c = src.rgb; if (sharpen > 0.001) { vec2 px = 1.0 / resolution; vec3 n = texture2D(image, uv + vec2(px.x, 0.0)).rgb + texture2D(image, uv - vec2(px.x, 0.0)).rgb + texture2D(image, uv + vec2(0.0, px.y)).rgb + texture2D(image, uv - vec2(0.0, px.y)).rgb; c += sharpen * 0.5 * (c * 4.0 - n); } c *= pow(2.0, exposure); c += vec3(temperature * 0.10 + tint * 0.04, -tint * 0.08, -temperature * 0.10 + tint * 0.04); c += wheelTint(liftx, lifty) * 0.4 + vec3(liftm * 0.4); c = max(c, vec3(0.0)); vec3 gtn = wheelTint(gammax, gammay) * 0.8 + vec3(gammam * 0.8); c = pow(c, vec3(1.0) / max(vec3(1.0) + gtn, vec3(0.2))); c *= vec3(1.0) + wheelTint(gainx, gainy) * 0.8 + vec3(gainm * 0.8); float l = dot(c, vec3(0.299, 0.587, 0.114)); float lo = 1.0 - smoothstep(0.0, 0.5, l); float hi = smoothstep(0.5, 1.0, l); c += vec3(shadows * 0.25 * lo + highlights * 0.25 * hi); c += vec3(blacks * 0.15 * (1.0 - smoothstep(0.0, 0.25, l)) + whites * 0.15 * smoothstep(0.75, 1.0, l)); c = (c - vec3(0.5)) * (1.0 + contrast) + vec3(0.5); float g = dot(c, vec3(0.299, 0.587, 0.114)); float spread = max(c.r, max(c.g, c.b)) - min(c.r, min(c.g, c.b)); c = mix(vec3(g), c, 1.0 + saturation + vibrance * (1.0 - spread)); float ang = hue * 6.2831853; float cs = cos(ang); float sn = sin(ang); vec3 k = vec3(0.57735, 0.57735, 0.57735); c = c * cs + cross(k, c) * sn + k * dot(k, c) * (1.0 - cs); c = clamp(c, 0.0, 1.0); c = vec3(crv(c.r, cm1, cm2, cm3), crv(c.g, cm1, cm2, cm3), crv(c.b, cm1, cm2, cm3)); c = vec3(crv(c.r, cr1, cr2, cr3), crv(c.g, cg1, cg2, cg3), crv(c.b, cb1, cb2, cb3)); c *= 1.0 - vignette * smoothstep(0.25, 0.85, distance(uv, vec2(0.5, 0.5))); c += (rnd(uv * resolution + floor(time * 24.0) * 17.0) - 0.5) * grain * 0.25; return vec4(clamp(c, 0.0, 1.0), src.a); }"}
