{"neofx":2,"id":"crt","name":"CRT","category":"Retro","params":[{"id":"curve","name":"Curve","min":0,"max":1,"default":0.4},{"id":"scan","name":"Scanlines","min":0,"max":1,"default":0.5}],"shader":"vec4 effect(vec2 uv) { vec2 c = uv * 2.0 - 1.0; c *= 1.0 + curve * dot(c, c) * 0.25; vec2 p = c * 0.5 + 0.5; if (p.x < 0.0 || p.x > 1.0 || p.y < 0.0 || p.y > 1.0) { return vec4(0.0, 0.0, 0.0, 1.0); } vec4 col = texture2D(image, p); float s = 0.5 + 0.5 * sin(p.y * resolution.y * 3.1416); col.rgb *= 1.0 - scan * (1.0 - s) * 0.6; col.rgb *= 1.0 - 0.25 * dot(c, c) * curve; return col; }"}
