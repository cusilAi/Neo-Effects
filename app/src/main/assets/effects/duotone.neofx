{"neofx":2,"id":"duotone","name":"Duotone","category":"Color","params":[{"id":"shade","name":"Shadow hue","min":0,"max":1,"default":0.65},{"id":"lite","name":"Light hue","min":0,"max":1,"default":0.05},{"id":"mixamt","name":"Amount","min":0,"max":1,"default":1}],"shader":"vec3 hue(float h) { return clamp(abs(mod(h * 6.0 + vec3(0.0, 4.0, 2.0), 6.0) - 3.0) - 1.0, 0.0, 1.0); } vec4 effect(vec2 uv) { vec4 c = texture2D(image, uv); float l = dot(c.rgb, vec3(0.299, 0.587, 0.114)); vec3 d = mix(hue(shade) * 0.5, hue(lite), l); return vec4(mix(c.rgb, d, mixamt), c.a); }"}
