{"neofx":2,"id":"edges","name":"Edge Outline","category":"Stylize","params":[{"id":"strength","name":"Strength","min":0,"max":4,"default":1.5},{"id":"blend","name":"Blend","min":0,"max":1,"default":1}],"shader":"float lum(vec2 p) { return dot(texture2D(image, p).rgb, vec3(0.333, 0.333, 0.333)); } vec4 effect(vec2 uv) { vec2 px = 1.0 / resolution; float tl = lum(uv + vec2(-px.x, -px.y)); float t = lum(uv + vec2(0.0, -px.y)); float tr = lum(uv + vec2(px.x, -px.y)); float l = lum(uv + vec2(-px.x, 0.0)); float r = lum(uv + vec2(px.x, 0.0)); float bl = lum(uv + vec2(-px.x, px.y)); float b = lum(uv + vec2(0.0, px.y)); float br = lum(uv + vec2(px.x, px.y)); float gx = -tl - 2.0 * l - bl + tr + 2.0 * r + br; float gy = -tl - 2.0 * t - tr + bl + 2.0 * b + br; float e = clamp(length(vec2(gx, gy)) * strength, 0.0, 1.0); vec4 c = texture2D(image, uv); return vec4(mix(c.rgb, vec3(e), blend), c.a); }"}
