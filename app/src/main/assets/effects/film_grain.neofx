{"neofx":1,"id":"film_grain","name":"Film Grain","category":"Cinematic","params":[{"id":"amount","name":"Amount","min":0,"max":1,"default":0.25}],"shader":"uniform shader image; uniform float2 resolution; uniform float time; uniform float amount; float rnd(float2 s) { return fract(sin(dot(s, float2(12.9898, 78.233))) * 43758.5453); } half4 main(float2 p) { half4 c = image.eval(p); float n = rnd(p + floor(time * 24.0) * 17.0) - 0.5; return half4(c.rgb + half3(half(n * amount)), c.a); }"}
