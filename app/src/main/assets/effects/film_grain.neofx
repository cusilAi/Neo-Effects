{"neofx":2,"id":"film_grain","name":"Film Grain","category":"Cinematic","params":[{"id":"amount","name":"Amount","min":0,"max":1,"default":0.25}],"shader":"float rnd(vec2 s) { return fract(sin(dot(s, vec2(12.9898, 78.233))) * 43758.5453); } vec4 effect(vec2 uv) { vec4 c = texture2D(image, uv); float n = rnd(uv * resolution + floor(time * 24.0) * 17.0) - 0.5; return vec4(c.rgb + vec3(n * amount), c.a); }"}
