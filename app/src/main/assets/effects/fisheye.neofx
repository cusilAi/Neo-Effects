{"neofx":2,"id":"fisheye","name":"Fisheye","category":"Distort","params":[{"id":"strength","name":"Strength","min":-1,"max":1,"default":0.5}],"shader":"vec4 effect(vec2 uv) { vec2 c = uv - vec2(0.5, 0.5); float r = length(c); float k = 1.0 + strength * r * r * 2.0; vec2 q = c / k + vec2(0.5, 0.5); return texture2D(image, q); }"}
