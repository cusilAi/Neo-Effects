{"neofx":2,"id":"glow","name":"Glow","category":"Light","params":[{"id":"threshold","name":"Threshold","min":0,"max":1,"default":0.6},{"id":"intensity","name":"Intensity","min":0,"max":3,"default":1},{"id":"radius","name":"Radius","min":1,"max":40,"default":12}],"shader":"vec4 effect(vec2 uv) { vec4 base = texture2D(image, uv); vec2 px = radius / resolution; vec3 g = vec3(0.0); for (int i = 0; i < 8; i++) { float a = float(i) * 0.785398; vec2 d = vec2(cos(a), sin(a)); vec3 s1 = texture2D(image, uv + d * px).rgb; vec3 s2 = texture2D(image, uv + d * px * 0.5).rgb; g += max(s1 - vec3(threshold), vec3(0.0)) + max(s2 - vec3(threshold), vec3(0.0)); } g /= 16.0; return vec4(base.rgb + g * intensity * 3.0, base.a); }"}
