{"neofx":2,"id":"halftone","name":"Halftone","category":"Stylize","params":[{"id":"dots","name":"Dot size","min":4,"max":40,"default":12},{"id":"mixamt","name":"Amount","min":0,"max":1,"default":1}],"shader":"vec4 effect(vec2 uv) { vec2 p = uv * resolution; vec2 cell = floor(p / dots) * dots + vec2(dots * 0.5, dots * 0.5); vec4 c = texture2D(image, cell / resolution); float l = dot(c.rgb, vec3(0.299, 0.587, 0.114)); float r = dots * 0.5 * sqrt(l); float d = distance(p, cell); float m = 1.0 - smoothstep(r - 1.0, r, d); return vec4(mix(c.rgb, c.rgb * m, mixamt), c.a); }"}
