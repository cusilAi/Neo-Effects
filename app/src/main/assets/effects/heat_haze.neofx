{"neofx":2,"id":"heat_haze","name":"Heat Haze","category":"Distort","params":[{"id":"amount","name":"Amount","min":0,"max":30,"default":8},{"id":"rate","name":"Speed","min":0,"max":5,"default":1.5},{"id":"freq","name":"Frequency","min":2,"max":40,"default":12}],"shader":"vec4 effect(vec2 uv) { float t = time * rate; vec2 o = vec2(sin(uv.y * freq + t * 2.0), cos(uv.x * freq * 0.8 + t * 1.7)) * amount / resolution; return texture2D(image, uv + o); }"}
