{"neofx":2,"id":"kaleidoscope","name":"Kaleidoscope","category":"Distort","params":[{"id":"segments","name":"Segments","min":2,"max":16,"default":6},{"id":"spin","name":"Spin","min":0,"max":2,"default":0.2}],"shader":"vec4 effect(vec2 uv) { float asp = resolution.x / resolution.y; vec2 p = (uv - vec2(0.5, 0.5)) * vec2(asp, 1.0); float a = atan(p.y, p.x) + time * spin; float r = length(p); float seg = 6.2831853 / max(segments, 1.0); a = mod(a, seg); a = abs(a - seg * 0.5); vec2 q = vec2(cos(a), sin(a)) * r; q = q / vec2(asp, 1.0) + vec2(0.5, 0.5); return texture2D(image, q); }"}
