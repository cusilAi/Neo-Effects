{"neofx":2,"id":"light_leak","name":"Light Leak","category":"Light","params":[{"id":"intensity","name":"Intensity","min":0,"max":1,"default":0.6},{"id":"drift","name":"Drift speed","min":0,"max":3,"default":0.5}],"shader":"vec4 effect(vec2 uv) { vec4 c = texture2D(image, uv); float t = time * drift; vec2 p = vec2(0.5 + 0.5 * sin(t), 0.5 + 0.4 * cos(t * 0.7)); float d = distance(uv, p); vec3 leak = mix(vec3(1.0, 0.35, 0.1), vec3(1.0, 0.8, 0.3), smoothstep(0.0, 0.8, d)) * smoothstep(0.9, 0.0, d); vec3 o = vec3(1.0) - (vec3(1.0) - c.rgb) * (vec3(1.0) - leak * intensity); return vec4(o, c.a); }"}
