{"neofx":2,"id":"pixelate","name":"Pixelate","category":"Stylize","params":[{"id":"size","name":"Block size","min":1,"max":80,"default":16}],"shader":"vec4 effect(vec2 uv) { float s = max(size, 1.0); vec2 p = uv * resolution; vec2 q = (floor(p / s) * s + vec2(s * 0.5, s * 0.5)) / resolution; return texture2D(image, q); }"}
