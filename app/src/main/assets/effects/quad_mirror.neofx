{"neofx":2,"id":"quad_mirror","name":"Quad Mirror","category":"Distort","params":[{"id":"amount","name":"Amount","min":0,"max":1,"default":1}],"shader":"vec4 effect(vec2 uv) { vec2 q = vec2(abs(uv.x - 0.5), abs(uv.y - 0.5)); vec4 m = texture2D(image, vec2(0.5, 0.5) - q); return mix(texture2D(image, uv), m, amount); }"}
