{"neofx":1,"id":"rgb_split","name":"RGB Split","category":"Glitch","params":[{"id":"amount","name":"Amount","min":0,"max":60,"default":14}],"shader":"uniform shader image; uniform float2 resolution; uniform float time; uniform float amount; half4 main(float2 p) { float s = amount * (0.5 + 0.5 * sin(time * 6.0)); half4 c = image.eval(p); half r = image.eval(p + float2(s, 0.0)).r; half b = image.eval(p - float2(s, 0.0)).b; return half4(r, c.g, b, c.a); }"}
