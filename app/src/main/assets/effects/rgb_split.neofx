{"neofx":2,"id":"rgb_split","name":"RGB Split","category":"Glitch","params":[{"id":"amount","name":"Amount","min":0,"max":60,"default":14}],"shader":"vec4 effect(vec2 uv) { float s = amount * (0.5 + 0.5 * sin(time * 6.0)) / resolution.x; vec4 c = texture2D(image, uv); float r = texture2D(image, uv + vec2(s, 0.0)).r; float b = texture2D(image, uv - vec2(s, 0.0)).b; return vec4(r, c.g, b, c.a); }"}
