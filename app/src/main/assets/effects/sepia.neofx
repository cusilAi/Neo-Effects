{"neofx":2,"id":"sepia","name":"Sepia","category":"Color","params":[{"id":"amount","name":"Amount","min":0,"max":1,"default":1}],"shader":"vec4 effect(vec2 uv) { vec4 c = texture2D(image, uv); vec3 s = vec3(dot(c.rgb, vec3(0.393, 0.769, 0.189)), dot(c.rgb, vec3(0.349, 0.686, 0.168)), dot(c.rgb, vec3(0.272, 0.534, 0.131))); return vec4(mix(c.rgb, min(s, vec3(1.0)), amount), c.a); }"}
