{"neofx":2,"id":"sharpen","name":"Sharpen","category":"Detail","params":[{"id":"amount","name":"Amount","min":0,"max":3,"default":1}],"shader":"vec4 effect(vec2 uv) { vec2 px = 1.0 / resolution; vec4 c = texture2D(image, uv); vec4 n = texture2D(image, uv + vec2(px.x, 0.0)) + texture2D(image, uv - vec2(px.x, 0.0)) + texture2D(image, uv + vec2(0.0, px.y)) + texture2D(image, uv - vec2(0.0, px.y)); return vec4(clamp(c.rgb + amount * 0.5 * (c.rgb * 4.0 - n.rgb), 0.0, 1.0), c.a); }"}
