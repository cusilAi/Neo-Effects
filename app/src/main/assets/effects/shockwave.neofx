{"neofx":2,"id":"shockwave","name":"Shockwave","category":"Distort","params":[{"id":"strength","name":"Strength","min":0,"max":0.2,"default":0.05},{"id":"pulse","name":"Speed","min":0.2,"max":3,"default":1},{"id":"ringw","name":"Ring width","min":0.02,"max":0.3,"default":0.1}],"shader":"vec4 effect(vec2 uv) { float asp = resolution.x / resolution.y; vec2 d = (uv - vec2(0.5, 0.5)) * vec2(asp, 1.0); float r = length(d); float t = fract(time * pulse * 0.5) * 1.2; float k = (r - t) / ringw; float w = exp(-k * k); vec2 dir = d / max(r, 0.0001); vec2 off = dir * w * strength / vec2(asp, 1.0); return texture2D(image, uv - off); }"}
