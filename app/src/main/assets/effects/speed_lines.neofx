{"neofx":2,"id":"speed_lines","name":"Speed Lines","category":"Light","params":[{"id":"density","name":"Lines","min":10,"max":120,"default":60},{"id":"power","name":"Strength","min":0,"max":1,"default":0.8},{"id":"rate","name":"Speed","min":0,"max":10,"default":6},{"id":"inner","name":"Clear center","min":0.1,"max":0.8,"default":0.35}],"shader":"float rnd(float x) { return fract(sin(x * 91.345) * 47453.5453); } vec4 effect(vec2 uv) { vec4 c = texture2D(image, uv); float asp = resolution.x / resolution.y; vec2 d = (uv - vec2(0.5, 0.5)) * vec2(asp, 1.0); float a = atan(d.y, d.x); float r = length(d); float id = floor((a + 3.14159) / 6.28318 * density); float t = floor(time * rate); float k = step(0.5, rnd(id + t * 13.7)); float m = smoothstep(inner, inner + 0.25, r) * k; return vec4(mix(c.rgb, vec3(1.0), m * power), c.a); }"}
