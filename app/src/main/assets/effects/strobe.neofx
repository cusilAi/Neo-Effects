{"neofx":2,"id":"strobe","name":"Strobe Flash","category":"Light","params":[{"id":"speed","name":"Speed","min":0.5,"max":20,"default":6},{"id":"intensity","name":"Intensity","min":0,"max":1,"default":0.6}],"shader":"vec4 effect(vec2 uv) { vec4 c = texture2D(image, uv); float f = pow(max(0.0, sin(time * speed * 3.1416)), 8.0); return vec4(mix(c.rgb, vec3(1.0), f * intensity), c.a); }"}
