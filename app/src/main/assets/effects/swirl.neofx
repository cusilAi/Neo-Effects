{"neofx":2,"id":"swirl","name":"Swirl","category":"Distort","params":[{"id":"angle","name":"Angle","min":-6,"max":6,"default":2},{"id":"radius","name":"Radius","min":0.1,"max":1,"default":0.5}],"shader":"vec4 effect(vec2 uv) { float asp = resolution.x / resolution.y; vec2 p = (uv - vec2(0.5, 0.5)) * vec2(asp, 1.0); float r = length(p); float k = max(1.0 - r / radius, 0.0); float a = angle * k * k; float cs = cos(a); float sn = sin(a); vec2 q = vec2(p.x * cs - p.y * sn, p.x * sn + p.y * cs); q = q / vec2(asp, 1.0) + vec2(0.5, 0.5); return texture2D(image, q); }"}
