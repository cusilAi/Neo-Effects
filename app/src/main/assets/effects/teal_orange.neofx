{"neofx":2,"id":"teal_orange","name":"Teal & Orange","category":"Color","params":[{"id":"amount","name":"Amount","min":0,"max":3,"default":1.2}],"shader":"vec4 effect(vec2 uv) { vec4 c = texture2D(image, uv); float l = dot(c.rgb, vec3(0.299, 0.587, 0.114)); float w = smoothstep(0.2, 0.8, l); vec3 o = c.rgb + amount * ((1.0 - w) * vec3(-0.06, 0.03, 0.09) + w * vec3(0.09, 0.03, -0.07)); o = (o - vec3(0.5)) * (1.0 + 0.1 * amount) + vec3(0.5); return vec4(clamp(o, 0.0, 1.0), c.a); }"}
