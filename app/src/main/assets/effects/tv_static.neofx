{"neofx":2,"id":"tv_static","name":"TV Static","category":"Retro","params":[{"id":"noisy","name":"Static","min":0,"max":1,"default":0.35},{"id":"bands","name":"Lines","min":0,"max":1,"default":0.4}],"shader":"float rnd(vec2 s) { return fract(sin(dot(s, vec2(12.9898, 78.233))) * 43758.5453); } vec4 effect(vec2 uv) { vec4 c = texture2D(image, uv); float n = rnd(uv * resolution + floor(time * 30.0) * 13.0); float l = 0.5 + 0.5 * sin(uv.y * resolution.y * 1.2 + time * 20.0); vec3 o = mix(c.rgb, vec3(n), noisy * 0.5); o *= 1.0 - bands * 0.3 * (1.0 - l); return vec4(o, c.a); }"}
