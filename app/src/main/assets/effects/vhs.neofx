{"neofx":2,"id":"vhs","name":"VHS","category":"Retro","params":[{"id":"wobble","name":"Wobble","min":0,"max":1,"default":0.5},{"id":"grain","name":"Grain","min":0,"max":1,"default":0.3},{"id":"bleed","name":"Color Bleed","min":0,"max":20,"default":6}],"shader":"float rnd(vec2 s) { return fract(sin(dot(s, vec2(12.9898, 78.233))) * 43758.5453); } vec4 effect(vec2 uv) { float ln = floor(uv.y * resolution.y / 3.0); float jitter = (rnd(vec2(ln, floor(time * 15.0))) - 0.5) * 0.004 * wobble; float roll = sin(uv.y * 6.0 + time * 2.0) * 0.002 * wobble; vec2 p = vec2(uv.x + jitter + roll, uv.y); float b = bleed / resolution.x; float r = texture2D(image, p + vec2(b, 0.0)).r; vec4 c = texture2D(image, p); float bl = texture2D(image, p - vec2(b, 0.0)).b; vec3 col = vec3(r, c.g, bl); col *= 0.92 + 0.08 * sin(uv.y * resolution.y * 1.5); col += (rnd(uv * resolution + time * 50.0) - 0.5) * 0.25 * grain; return vec4(col, c.a); }"}
