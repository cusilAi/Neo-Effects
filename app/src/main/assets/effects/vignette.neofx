{"neofx":1,"id":"vignette","name":"Vignette","category":"Cinematic","params":[{"id":"strength","name":"Strength","min":0,"max":1,"default":0.7}],"shader":"uniform shader image; uniform float2 resolution; uniform float time; uniform float strength; half4 main(float2 p) { half4 c = image.eval(p); float2 uv = p / resolution; float d = distance(uv, float2(0.5, 0.5)); float v = 1.0 - strength * smoothstep(0.25, 0.85, d); return half4(c.rgb * half(v), c.a); }"}
