{"neofx":2,"id":"vignette","name":"Vignette","category":"Cinematic","params":[{"id":"strength","name":"Strength","min":0,"max":1,"default":0.7}],"shader":"vec4 effect(vec2 uv) { vec4 c = texture2D(image, uv); float d = distance(uv, vec2(0.5, 0.5)); float v = 1.0 - strength * smoothstep(0.25, 0.85, d); return vec4(c.rgb * v, c.a); }"}
