{"neofx":2,"id":"warm_cool","name":"Warm / Cool","category":"Color","params":[{"id":"warmth","name":"Warmth","min":-1,"max":1,"default":0.3},{"id":"tint","name":"Tint","min":-1,"max":1,"default":0}],"shader":"vec4 effect(vec2 uv) { vec4 c = texture2D(image, uv); vec3 o = c.rgb + vec3(warmth * 0.12 + tint * 0.04, -tint * 0.08, -warmth * 0.12 + tint * 0.04); return vec4(clamp(o, 0.0, 1.0), c.a); }"}
