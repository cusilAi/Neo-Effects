{"neofx":2,"id":"zoom_pulse","name":"Zoom Pulse","category":"Motion","params":[{"id":"amount","name":"Amount","min":0,"max":0.5,"default":0.15},{"id":"speed","name":"Speed","min":0.1,"max":8,"default":2}],"shader":"vec4 effect(vec2 uv) { float k = 1.0 + amount * pow(0.5 + 0.5 * sin(time * speed * 6.2832), 3.0); vec2 p = (uv - vec2(0.5, 0.5)) / k + vec2(0.5, 0.5); return texture2D(image, p); }"}
