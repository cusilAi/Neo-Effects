{"neofx":1,"id":"wave","name":"Wave","category":"Distort","params":[{"id":"strength","name":"Strength","min":0,"max":60,"default":20},{"id":"speed","name":"Speed","min":0,"max":10,"default":3}],"shader":"uniform shader image; uniform float2 resolution; uniform float time; uniform float strength; uniform float speed; half4 main(float2 p) { float2 q = p; q.x += sin(p.y / 40.0 + time * speed) * strength; return image.eval(q); }"}
